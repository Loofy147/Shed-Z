      "permissions": [
        "read_allowlisted_repository",
        "write_scratch_worktree",
        "run_allowlisted_tests"
      ],
      "forbidden_effects": [
        "direct_push_to_protected_branch",
        "merge",
        "deploy",
        "production_credentials",
        "unapproved_network_egress"
      ],
      "acceptance": [
        "diff_retained",
        "tests_recorded",
        "failure_status_explicit",
        "independent_review_completed"
      ],
      "required_inputs": [
        "explicit_repository",
        "pinned_ref",
        "bounded_change_request",
        "test_command_allowlist",
        "resource_limits"
      ]
